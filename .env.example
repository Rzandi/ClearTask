# ─── ClearTask Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.
#
# ClearTask is an offline-first PWA. Most features work without any env vars.
# These variables are only needed for optional integrations.

# ── Build / Dev ───────────────────────────────────────────────────────────────

# Set to "true" to generate a bundle size report at dist/stats.html after build.
# Usage: ANALYZE=true npm run build
ANALYZE=false

# ── Future: Cloud Backup (Google Drive) ──────────────────────────────────────
# These are NOT used yet. They are placeholders for the planned Cloud Backup
# feature described in docs/audit/sync-design.md.

# Google OAuth2 Client ID (public — safe to expose in frontend)
# VITE_GOOGLE_CLIENT_ID=

# Google Drive API scope (default: drive.appdata for sandboxed storage)
# VITE_GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.appdata

# ── Future: Analytics / Error Tracking ───────────────────────────────────────
# VITE_SENTRY_DSN=
